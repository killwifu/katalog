:80 {
	root * /srv
	encode gzip

	# Хешированные ассеты иммутабельны: имя меняется вместе с содержимым.
	# В SPA-фолбэк они попадать не должны — иначе после деплоя пропавший
	# чанк отдавался бы как index.html с Content-Type text/html,
	# и динамический import падал бы на несовпадении MIME.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		# index.html не кешируем без проверки. Он ссылается на хешированные
		# чанки, поэтому устаревшая копия в кеше браузера означает запросы
		# к именам, которых на сервере уже нет.
		#
		# Без Cache-Control браузер применяет эвристику: считает страницу
		# свежей ~10% её возраста и к серверу не обращается вовсе. Чем
		# дольше живёт сборка, тем дольше держится старая копия — поэтому
		# директива обязательна.
		#
		# no-cache, а не no-store: перепроверка дешёвая, ETag отдаёт 304.
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
