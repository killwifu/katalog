# Прод-окружение. Скопировать на сервер как .env и заполнить.
# Используется с deploy/docker-compose.prod.yml.
# Переменные без значения по умолчанию обязательны — compose откажется
# стартовать, если их не задать.

# --- Домен и TLS ------------------------------------------------------------
# A-запись должна указывать на этот сервер, порты 80 и 443 открыты:
# Caddy выпускает сертификат Let's Encrypt сам.
APP_DOMAIN=katalog.example.ru
ACME_EMAIL=admin@example.ru

# --- Образы -----------------------------------------------------------------
# Владелец пакетов в GHCR (обычно GitHub-логин или организация).
GHCR_OWNER=killwifu
# Тег образов: sha коммита или latest. Пин на sha делает откат тривиальным.
IMAGE_TAG=latest

# --- База данных ------------------------------------------------------------
POSTGRES_USER=katalog
# openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=katalog

# --- Хранилище (облачный S3) ------------------------------------------------
# Пример для Yandex Object Storage; VK Cloud и другие S3-совместимые — так же.
S3_ENDPOINT=https://storage.yandexcloud.net
# Тот же адрес попадает в pre-signed URL, по которому браузер грузит оригинал.
S3_PUBLIC_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=katalog
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Регион в scope подписи SigV4. Провайдер проверяет его строго: неверное
# значение — presigned URL отлетают с SignatureDoesNotMatch, и загрузка
# фото не работает. Yandex — ru-central1, VK Cloud — ru-msk.
S3_REGION=ru-central1
# Префикс адресов деривативов: отдельный CDN-домен, смотрящий на префикс
# drv/ в бакете. Контент не должен отдаваться с домена приложения.
MEDIA_BASE_URL=https://cdn.example.ru/drv

# --- Секреты приложения -----------------------------------------------------
# openssl rand -hex 32
REVALIDATE_SECRET=

# --- Почта (регистрация, сброс пароля, письма о подписке) -------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example.ru
# Ящик модератора: жалобы и алерты по трафику.
ADMIN_EMAIL=

# --- Платежи ----------------------------------------------------------------
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Модерация и алерты -----------------------------------------------------
STOP_WORDS=контрафакт,подделка бренда
TRAFFIC_ALERT_MULTIPLIER=5
TRAFFIC_ALERT_MIN_VIEWS=1000
