# Скопируйте в .env (make up сделает это сам, если .env нет).

# Postgres
POSTGRES_USER=katalog
POSTGRES_PASSWORD=katalog
POSTGRES_DB=katalog
# Хостовый порт контейнерного Postgres (смените, если 5432 занят локальным).
POSTGRES_PORT=5432

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=katalog
# Endpoint S3, доступный из браузера (для presigned-URL загрузки).
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Host, для которого API подписал presigned-URL: host из S3_PUBLIC_ENDPOINT,
# без схемы и с портом, если он нестандартный (пример: cdn.example.com:8080).
# Нужен, ТОЛЬКО если внешний прокси переписывает Host и ломает SigV4-подпись
# (так делает Codespaces — см. .devcontainer/setup.sh). Пусто = Caddy передаёт
# Host клиента как есть. Значение, не совпадающее с S3_PUBLIC_ENDPOINT,
# даёт SignatureDoesNotMatch (403) на каждой загрузке.
S3_SIGNING_HOST=

# Secure-флаг сессионной cookie (в проде за TLS — true).
COOKIE_SECURE=false

# Shared secret вебхука ревалидации Go -> Next (в проде сгенерировать!).
REVALIDATE_SECRET=dev-revalidate-secret

# Транзакционная почта. Пустой SMTP_HOST = письма пишутся в лог воркера (dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@localhost
# Куда слать уведомления о новых жалобах (пусто = не слать).
ADMIN_EMAIL=

# Стоп-слова подписей (через запятую): совпадение -> флаг на ручную проверку.
STOP_WORDS=контрафакт,подделка бренда

# Алерт на аномальный CDN-трафик магазина (письмо на ADMIN_EMAIL):
# дневные просмотры > MULTIPLIER x средненедельных и >= MIN_VIEWS.
TRAFFIC_ALERT_MULTIPLIER=5
TRAFFIC_ALERT_MIN_VIEWS=1000

# ЮKassa (https://yookassa.ru). Пусто = платежи выключены (subscribe вернёт 503).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда ЮKassa возвращает пользователя после оплаты.
BILLING_RETURN_URL=http://localhost/app/billing
# Тарифы: лимиты и цены (дефолты см. backend/internal/config).
# PLAN_FREE_MAX_PHOTOS=500        PLAN_FREE_MAX_STORAGE_MB=1024
# PLAN_BASIC_MAX_PHOTOS=5000      PLAN_BASIC_MAX_STORAGE_MB=10240   PLAN_BASIC_PRICE_RUB=490
# PLAN_PRO_MAX_PHOTOS=20000       PLAN_PRO_MAX_STORAGE_MB=20480     PLAN_PRO_PRICE_RUB=990
# BILLING_GRACE_DAYS=14           BILLING_PERIOD_DAYS=30
# Публичный базовый URL витрины (метатеги, sitemap).
SITE_URL=http://localhost

# Для запуска бэкенда локально, вне docker (go run ./cmd/api):
DATABASE_URL=postgres://katalog:katalog@localhost:5432/katalog?sslmode=disable
REDIS_ADDR=localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Для витрины локально, вне docker (npm run dev): адрес Go API и Redis.
API_URL=http://localhost:8080
REDIS_URL=redis://localhost:6379
STOREFRONT_URL=http://localhost:3000
