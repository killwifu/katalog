# Скопируйте в .env (make up сделает это сам, если .env нет).

# Postgres
POSTGRES_USER=katalog
POSTGRES_PASSWORD=katalog
POSTGRES_DB=katalog
# Хостовый порт контейнерного Postgres (смените, если 5432 занят локальным).
POSTGRES_PORT=5432

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=katalog
# Endpoint S3, доступный из браузера (для presigned-URL загрузки).
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Secure-флаг сессионной cookie (в проде за TLS — true).
COOKIE_SECURE=false

# Shared secret вебхука ревалидации Go -> Next (в проде сгенерировать!).
REVALIDATE_SECRET=dev-revalidate-secret
# Публичный базовый URL витрины (метатеги, sitemap).
SITE_URL=http://localhost

# Для запуска бэкенда локально, вне docker (go run ./cmd/api):
DATABASE_URL=postgres://katalog:katalog@localhost:5432/katalog?sslmode=disable
REDIS_ADDR=localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Для витрины локально, вне docker (npm run dev): адрес Go API и Redis.
API_URL=http://localhost:8080
REDIS_URL=redis://localhost:6379
STOREFRONT_URL=http://localhost:3000
