{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BackupWriteReadNoDelete",
      "Effect": "Allow",
      "Principal": {"CanonicalUser": "<SERVICE_ACCOUNT_ID>"},
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::<BUCKET>",
        "arn:aws:s3:::<BUCKET>/*"
      ]
    }
  ]
}
