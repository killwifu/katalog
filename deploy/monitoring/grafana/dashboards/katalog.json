{
 "uid": "katalog-overview",
 "title": "Katalog — обзор",
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "p95 публичного API, с",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(katalog_public_request_seconds_bucket[5m])))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Запросы публичного API, rps",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(katalog_public_request_seconds_count[5m]))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Очередь asynq",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "katalog_queue_pending",
     "legendFormat": "katalog_queue_pending"
    },
    {
     "refId": "B",
     "expr": "katalog_queue_active",
     "legendFormat": "katalog_queue_active"
    },
    {
     "refId": "C",
     "expr": "katalog_queue_retry",
     "legendFormat": "katalog_queue_retry"
    },
    {
     "refId": "D",
     "expr": "katalog_queue_archived",
     "legendFormat": "katalog_queue_archived"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Загрузки сегодня / активные магазины",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "katalog_uploads_today",
     "legendFormat": "katalog_uploads_today"
    },
    {
     "refId": "B",
     "expr": "katalog_active_shops",
     "legendFormat": "katalog_active_shops"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "CPU, %",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Свободная память",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_memory_MemAvailable_bytes",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Свободно на диске /",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"}",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Postgres: соединения",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(pg_stat_database_numbackends)",
     "legendFormat": ""
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Цели Prometheus (1 = отвечает)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 32
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up",
     "legendFormat": "{{job}}"
    }
   ]
  }
 ]
}
