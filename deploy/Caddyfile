# Локальный reverse-proxy. В проде здесь появится домен и автоматический TLS.
:80 {
	# Заголовки безопасности на всё, что отдаётся наружу.
	#
	# frame-ancestors: витрину продавца нельзя встроить в чужой сайт.
	# Каталог — это и есть товар; без запрета конкурент показывает чужие
	# фотографии внутри своей страницы, а покупатель не видит подмены.
	#
	# nosniff: наружу уходят файлы, которые загрузил продавец. Пусть
	# браузер верит Content-Type, а не угадывает по содержимому.
	#
	# Referrer-Policy: покупатель уходит в мессенджер продавца, и полный
	# адрес просматриваемого альбома в реферере туда попадать не должен.
	#
	# HSTS: по http браузер его игнорирует, в проде за TLS — работает.
	header {
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	handle /healthz {
		reverse_proxy api:8080
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	# Загрузка оригиналов: pre-signed PUT в MinIO через основной порт
	# (путь = имя бакета) — там, где наружу проброшен только 80 (Codespaces).
	# Наружу отдаётся ТОЛЬКО префикс orig/: на корне бакета анонимный
	# ListBucket (bucket policy разрешает список drv/*) перечислил бы фото
	# всех магазинов. Чтение деривативов — ниже, через /media/*.
	# Host восстанавливается в тот, для которого API подписывал URL:
	# внешние прокси (Codespaces) переписывают Host, ломая SigV4-подпись.
	# Значение задаёт docker-compose; по умолчанию — Host клиента как есть.
	handle /{$S3_BUCKET:katalog}/orig/* {
		reverse_proxy minio:9000 {
			header_up Host {$S3_SIGNING_HOST}
		}
	}

	# Деривативы фото (только drv/, оригиналы наружу не отдаются).
	# В проде это отдельный CDN-домен. Ключ дериватива иммутабелен
	# (photo_id + размер) — кешируем навсегда.
	handle /media/* {
		uri replace /media/ /{$S3_BUCKET:katalog}/drv/
		reverse_proxy minio:9000 {
			header_down Cache-Control "public, max-age=31536000, immutable"
		}
	}

	redir /app /app/

	handle_path /app/* {
		reverse_proxy cabinet:80
	}

	# Всё остальное (в т.ч. /{slug}) — витрина Next.js.
	handle {
		reverse_proxy storefront:3000
	}
}
